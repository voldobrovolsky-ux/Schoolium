DATABASE_URL="postgresql://edustore:edustore@localhost:5432/edustore?schema=public"
PORT=3000
ASR_URL=http://localhost:8001
WEB_ORIGIN=http://localhost:5173

# ─────────────────────────── Флёрус OIDC (RP) ───────────────────────────
# AUTH_MODE управляет доступом (fail-closed):
#   dev|test|ci  — DEV-байпас по x-florus-user-id/-role (локальная разработка/e2e)
#   pilot-qr     — временный пилотный вход по QR (см. docs/PILOT.md), байпас выключен
#   production   — только реальная сессия Флёруса
#   (пусто/иное — байпас ВЫКЛЮЧЕН: опечатка в env не открывает аутентификацию)
AUTH_MODE=dev
# FLOR_ISSUER=https://accounts.flor-group.ru
# FLOR_CLIENT_ID=edustore
# FLOR_CLIENT_SECRET=
# FLOR_REDIRECT_URI=https://edustore-flor-group.ru/api/auth/flor/callback

# ─────────────────────────── Объектное хранилище S3 (Документохранилище) ───────────────────────────
# Namespace docs/ — управляемый контур (152-ФЗ). Ключи ТОЛЬКО здесь/в секрет-сторе, НИКОГДА в БД/коде.
# Пусто → сервис поднимается нормально, падает только файловая операция (внятная 503). Впиши позже.
#
# Где взять в консоли Yandex Cloud:
#   1. Object Storage → создать бакет (например edustore-docs) → S3_BUCKET.
#   2. IAM → сервисный аккаунт → роль storage.editor (на каталог/бакет).
#   3. Для этого аккаунта → «Создать статический ключ доступа» → выдаст
#        Access Key ID   → S3_ACCESS_KEY_ID
#        Secret Access Key → S3_SECRET_ACCESS_KEY   (показывается один раз — сохрани сразу)
#   4. Endpoint и регион у Yandex фиксированы:
#        S3_ENDPOINT=https://storage.yandexcloud.net
#        S3_REGION=ru-central1
# (AWS/MinIO — тот же провайдер, меняются только эти 5 значений.)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
