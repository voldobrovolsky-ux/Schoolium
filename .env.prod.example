# Schoolium production env (скопировать в .env.prod, НЕ коммитить). См. docs/DEPLOY.md.

# --- База ---
POSTGRES_USER=schoolium
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=schoolium

# --- Адрес стенда ---
# SITE_DOMAIN — домен для Caddy (вариант Б, авто-SSL).
# WEB_ORIGIN — публичный origin с протоколом. От него зависит ССЫЛКА ВХОДА,
# которую печатает school:bootstrap, и адрес в QR. Ошибётесь здесь — модератор
# получит нерабочую ссылку.
SITE_DOMAIN=schoolium.example.ru
WEB_ORIGIN=https://schoolium.example.ru

# Вариант В — БЕЗ домена, быстрый показ по голому IP (директору сегодня, до
# DNS). Раскомментируйте эти три строки и WEB_ORIGIN=http://<IP-сервера>
# ВМЕСТО https-строки выше; закомментируйте обратно, как только появится домен.
# WEB_BIND=0.0.0.0
# WEB_PORT=80

# --- Аутентификация ---
# Контур 1.1.1 (вход по телефону, cookie sch_sid) от AUTH_MODE не зависит и
# работает при любом значении. Переменная управляет только вытесняемым
# OIDC-контуром: production — без dev-bypass.
AUTH_MODE=production

# Снимает флаг secure с cookie сессии. ТОЛЬКО для стенда без TLS (вариант В
# выше). С данными живой школы недопустимо: cookie уйдёт по открытому каналу.
# Идёт В ПАРЕ с WEB_BIND/WEB_PORT — по отдельности толку нет.
# COOKIE_INSECURE=1

# --- Вытесняемый контур (КТП/КПП, Флёрус OIDC) ---
# Для Schoolium 1.1.1 НЕ НУЖНЫ. Пустые значения не мешают старту API:
# переменные читаются лениво, только на маршрутах старого контура.
FLOR_ISSUER=
FLOR_CLIENT_ID=
FLOR_CLIENT_SECRET=

# --- Голосовой ввод (вытесняемый контур) ---
# Сервис поднимается только с --profile asr. Эти значения нужны лишь тогда.
ASR_MOCK=1
ASR_MODEL=small
